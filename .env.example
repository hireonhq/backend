PORT=3000
NODE_ENV=development

DATABASE_URL=postgres://user:password@host:5432/hireon?sslmode=require

SUPABASE_URL=https://your-project.supabase.co

ML_SERVICE_URL=http://ml-service:8000/api
ML_SERVICE_API_KEY=
ML_TIMEOUT_SECONDS=30

# Cloudflare R2 (S3-compatible). Leave S3_ENDPOINT empty for AWS S3.
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=hireon
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

FRONTEND_URL=http://localhost:3000
